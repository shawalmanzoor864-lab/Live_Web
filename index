<script type="module">
const $=id=>document.getElementById(id);
const stage=$('stage'),vid=$('vid'),pic=$('pic'),cv=$('cv'),msg=$('msg'),ctx=cv.getContext('2d');
const cv3=$('cv3');let vw=1280,vh=960,mode=null,found=false,S=null,r3=null,cam3=null,m3=null;
function resize(w,h){vw=cv.width=w;vh=cv.height=h;stage.style.aspectRatio=w+'/'+h;if(r3){r3.setSize(w,h,false);cam3.right=w;cam3.bottom=-h;cam3.updateProjectionMatrix()}}
resize(1280,960);

/* ---------- flat 2D sprites (vector, transparent) ---------- */
const GR=(id,a,b,c)=>`<linearGradient id="${id}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="${a}"/><stop offset=".5" stop-color="${b}"/><stop offset="1" stop-color="${c}"/></linearGradient>`;
const RG=(id,a,b)=>`<radialGradient id="${id}" cx=".35" cy=".3" r=".8"><stop offset="0" stop-color="${a}"/><stop offset="1" stop-color="${b}"/></radialGradient>`;
const DEFS=`<defs>${GR('g','#fff6cf','#e0b550','#9a6d1c')}${GR('s','#ffffff','#c3cad6','#7b8494')}${RG('o','#ffffff','#b9c8e6')}${RG('p','#ffe3ee','#e58aae')}${RG('e','#6df0b3','#067a4c')}${RG('w','#ffffff','#d9d2c8')}<linearGradient id="h" x1="0" x2="1"><stop offset="0" stop-color="#1b3590"/><stop offset=".5" stop-color="#3d62d6"/><stop offset="1" stop-color="#1b3590"/></linearGradient></defs>`;
const SP=(w,h,body)=>{const i=new Image(w,h);i.src='data:image/svg+xml;utf8,'+encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" width="${w}" height="${h}" viewBox="0 0 ${w} ${h}">${DEFS}${body}</svg>`);return i};
const HEART='M50 85C5 50 0 20 25 8C40 2 50 15 50 22C50 15 60 2 75 8C100 20 95 50 50 85Z';
const TEAR='M50 4C60 30 86 48 86 68C86 92 14 92 14 68C14 48 40 30 50 4Z';
const bowG=(x,y,k,f,st)=>`<g transform="translate(${x} ${y}) scale(${k})" fill="${f}" stroke="${st}" stroke-width="2.5"><path d="M0 2L-14 44L0 33L14 44Z"/><path d="M0 0C10-25 45-22 45 2C45 30 12 28 0 0Z"/><path d="M0 0C-10-25-45-22-45 2C-45 30-12 28 0 0Z"/><circle r="8" fill="url(#g)"/></g>`;
const dots=(d,w)=>`<path d="${d}" fill="none" stroke="#fff" stroke-width="${w}" stroke-dasharray=".1 7" stroke-linecap="round"/>`;

const heartGold=SP(100,90,`<path d="${HEART}" fill="url(#g)" stroke="#8a5f12" stroke-width="2"/><path d="M22 18C30 12 40 14 44 22" stroke="#fff" stroke-width="5" fill="none" stroke-linecap="round" opacity=".7"/>`);
const bowEar=SP(100,175,`<circle cx="50" cy="6" r="5" fill="url(#g)"/><path d="M50 10V100" stroke="#c99a35" stroke-width="2"/>`+
 Array.from({length:14},(_,i)=>{const t=i/14*6.2832,x=50+16*Math.pow(Math.sin(t),3)*1.2,y=44-(13*Math.cos(t)-5*Math.cos(2*t)-2*Math.cos(3*t)-Math.cos(4*t))*1.2;return `<circle cx="${x}" cy="${y}" r="4.6" fill="url(#w)" stroke="#cfc6ba" stroke-width=".6"/>`}).join('')+bowG(50,112,1,'#fbf8f2','#c99a35'));
const dropP=SP(100,100,`<path d="${TEAR}" fill="url(#s)"/><path d="${TEAR}" transform="translate(50 62) scale(.78) translate(-50 -62)" fill="url(#o)"/>${dots(TEAR,3.5)}`);
const starP=SP(100,100,(()=>{let d='';for(let i=0;i<16;i++){const r=i%2?17:46,a=i/16*6.2832-1.5708;d+=(i?'L':'M')+(50+Math.cos(a)*r)+' '+(50+Math.sin(a)*r)}return `<path d="${d}Z" fill="url(#s)" stroke="#7b8494"/><circle cx="50" cy="50" r="8" fill="url(#w)"/>`+Array.from({length:8},(_,i)=>{const a=i/8*6.2832-1.5708;return `<circle cx="${50+Math.cos(a)*34}" cy="${50+Math.sin(a)*34}" r="2.6" fill="#fff"/>`}).join('')})());
const heartP=SP(100,100,`<path d="${HEART}" transform="translate(50 46) scale(1.15) translate(-50 -46)" fill="url(#s)"/><path d="${HEART}" transform="translate(50 46) scale(.85) translate(-50 -46)" fill="url(#o)"/>`);
const cherryP=SP(100,100,`<path d="M30 70Q40 30 52 12M72 80Q70 40 52 12" stroke="url(#s)" stroke-width="3" fill="none"/><path d="M52 12Q70 0 80 14Q64 24 52 12Z" fill="url(#s)"/><circle cx="30" cy="72" r="18" fill="url(#p)"/><circle cx="72" cy="80" r="18" fill="url(#p)"/><ellipse cx="24" cy="65" rx="5" ry="3" fill="#fff" opacity=".7"/><ellipse cx="66" cy="73" rx="5" ry="3" fill="#fff" opacity=".7"/>`);
const moonP=SP(100,100,`<path d="M70 12A40 40 0 1 0 88 78" fill="none" stroke="url(#s)" stroke-width="12" stroke-linecap="round"/>${dots('M70 12A40 40 0 1 0 88 78',5)}`);
const bowP=SP(100,100,bowG(50,40,1.05,'url(#o)','#9aa3b2')+`<circle cx="50" cy="40" r="3" fill="#fff"/>`);
const flowerP=SP(300,120,Array.from({length:5},(_,i)=>`<ellipse cx="150" cy="33" rx="11" ry="27" transform="rotate(${i*72} 150 60)" fill="#fff" stroke="#9aa3b2" stroke-width="1.5"/>`).join('')+
 [-1,1].map(sg=>[0,1,2].map(i=>`<ellipse cx="${150+sg*(62+i*34)}" cy="${56-i*8}" rx="7" ry="19" transform="rotate(${sg*(72-i*8)} ${150+sg*(62+i*34)} ${56-i*8})" fill="#fff" stroke="#9aa3b2" stroke-width="1.5"/>`).join('')).join('')+`<circle cx="150" cy="60" r="10" fill="url(#s)"/>`);
const collarP=SP(400,215,(()=>{const q=t=>[(1-t)*(1-t)*20+2*(1-t)*t*200+t*t*380,(1-t)*(1-t)*20+2*(1-t)*t*150+t*t*20];
 let o='<path d="M20 20Q200 150 380 20" stroke="url(#s)" stroke-width="5" fill="none"/>';
 for(let t=.1;t<.91;t+=.08){const[x,y]=q(t),k=.6+.5*(1-Math.abs(t-.5)*2);o+=`<path transform="translate(${x} ${y+4}) scale(${k})" d="M0 0C5 10 9 16 9 22C9 32-9 32-9 22C-9 16-5 10 0 0Z" fill="url(#w)" stroke="#9aa3b2"/>`;o+=`<path transform="translate(${x} ${y+4}) scale(${k}) translate(0 11) scale(1.6)" d="M0 0C5 10 9 16 9 22" fill="none"/>`}
 [[.5,44,1],[.32,28,1],[.68,28,1],[.18,14,0],[.42,14,0],[.58,14,0],[.82,14,0]].forEach(([t,s,r])=>{const[x,y]=q(t);if(r)for(let i=0;i<12;i++){const a=i/12*6.2832;o+=`<circle cx="${x+Math.cos(a)*s*.78}" cy="${y+Math.sin(a)*s*.78}" r="${s*.1}" fill="#fff" stroke="#9aa3b2" stroke-width=".8"/>`}
  o+=`<rect x="${x-s/2}" y="${y-s/2}" width="${s}" height="${s}" rx="${s*.18}" fill="url(#e)" stroke="url(#s)" stroke-width="2.5"/>`});return o})());
const hijabP=new Image();hijabP.src='data:image/png;base64,';

const IMGS={'bow-earrings.png':'data:image/jpeg;base64,','emerald-collar.png':'data:image/jpeg;base64,','flower-necklace.png':'data:image/jpeg;base64,','gold-heart-set.png':'data:image/jpeg;base64,','hijab-mauve.png':'data:image/jpeg;base64,','pend-bow.png':'data:image/jpeg;base64,','pend-cherry.png':'data:image/jpeg;base64,','pend-drop.png':'data:image/jpeg;base64,','pend-heart.png':'data:image/jpeg;base64,','pend-moon.png':'data:image/jpeg;base64,','pend-star.png':'data:image/jpeg;base64,'};
const CUT={"h1": "data:image/png;base64,", "h2": "data:image/png;base64,", "h3": "data:image/png;base64,", "h4": "data:image/png;base64,", "g1": "data:image/png;base64,", "g2": "data:image/png;base64,", "g3": "data:image/png;base64,", "g4": "data:image/png;base64,", "g5": "data:image/png;base64,"},CARD={"h1": "data:image/jpeg;base64,", "h2": "data:image/jpeg;base64,", "h3": "data:image/jpeg;base64,", "h4": "data:image/jpeg;base64,", "g1": "data:image/jpeg;base64,", "g2": "data:image/jpeg;base64,", "g3": "data:image/jpeg;base64,", "g4": "data:image/jpeg;base64,", "g5": "data:image/jpeg;base64,"};
const IM=u=>{const i=new Image();i.src=u;return i};
const I=(id,cat,name,price,photo,type,spr,w,o={})=>({id,cat,name,price,img:IMGS[photo],type,spr,w,...o});
const ITEMS=[
 I('e1','Earrings','Pearl Heart & Bow Earrings',2500,'bow-earrings.png','ear',bowEar,.17),
 I('e2','Earrings','Gold Heart Stud Earrings',1800,'gold-heart-set.png','ear',heartGold,.1),
 I('n1','Necklaces','Emerald & Diamond Collar',6900,'emerald-collar.png','neck',collarP,1.1,{glb:1}),
 I('n2','Necklaces','Crystal Blossom Silver Necklace',2600,'flower-necklace.png','pend',flowerP,.4),
 I('n3','Necklaces','Gold Heart Necklace',2200,'gold-heart-set.png','pend',heartGold,.13,{gold:1}),
 I('n4','Necklaces','Opal Teardrop Pendant',1800,'pend-drop.png','pend',dropP,.14),
 I('n5','Necklaces','Starburst Pearl Pendant',1600,'pend-star.png','pend',starP,.14),
 I('n6','Necklaces','Opal Heart Pendant',1900,'pend-heart.png','pend',heartP,.14),
 I('n7','Necklaces','Pink Cherry Pendant',1800,'pend-cherry.png','pend',cherryP,.14),
 I('n8','Necklaces','Crescent Moon Pendant',1700,'pend-moon.png','pend',moonP,.14),
 I('n9','Necklaces','Opal Bow Pendant',1900,'pend-bow.png','pend',bowP,.17),
 I('j1','Hijabs','Chiffon Hijab — Dusty Mauve',2400,'hijab-mauve.png','hijab',hijabP,1.8,{hole:[443.5,341.5,209]}),
 I('g1','Glasses','Clear Frame Glasses',1500,'','glass',IM(CUT.g1),1.1,{img:CARD.g1,contain:1}),
 I('g2','Glasses','Star Party Sunglasses',1200,'','glass',IM(CUT.g2),1.15,{img:CARD.g2,contain:1}),
 I('g3','Glasses','Classic Black Wayfarer',1800,'','glass',IM(CUT.g3),1.08,{img:CARD.g3,contain:1}),
 I('g4','Glasses','Black Aviator Sunglasses',2400,'','glass',IM(CUT.g4),1.1,{img:CARD.g4,contain:1}),
 I('g5','Glasses','Red Cat-Eye Sunglasses',1900,'','glass',IM(CUT.g5),1.12,{img:CARD.g5,contain:1}),
 I('h1','Hats','Natural Straw Fedora',2800,'','hat',IM(CUT.h1),2.1,{img:CARD.h1,contain:1,ap:.72}),
 I('h2','Hats','Cream Felt Hat with Leather Belt',3400,'','hat',IM(CUT.h2),2.2,{img:CARD.h2,contain:1,ap:.7}),
 I('h3','Hats','Teal Mesh Snapback Cap',1800,'','hat',IM(CUT.h3),1.7,{img:CARD.h3,ap:.8}),
 I('h4','Hats','Green Pixel-Face Cap',1600,'','hat',IM(CUT.h4),1.7,{img:CARD.h4,contain:1,ap:.8})
];
/* optional: put transparent cut-outs of your real photos in /cutouts/<id>.png and they replace the drawn sprites */
ITEMS.forEach(it=>{const c=new Image();c.onload=()=>it.cut=c;if(it.id!=='j1')c.src='cutouts/'+it.id+'.png'});

/* ---------- drawing ---------- */
const dim=im=>[im.naturalWidth||im.width,im.naturalHeight||im.height];
function draw(){ctx.clearRect(0,0,vw,vh);if(!S||!found||!mode)return;
 ctx.save();ctx.translate(S.x,S.y);ctx.rotate(S.th);ctx.scale(S.W,S.W);ctx.lineCap='round';
 const ord={hijab:0,hat:1,neck:1,pend:1,glass:2,ear:2,watch:3};
 Object.values(sel).map(id=>ITEMS.find(i=>i.id===id)).sort((a,b)=>ord[a.type]-ord[b.type]).forEach(it=>{
  if(it.type==='watch'||(it.glb&&m3))return;const im=it.cut||it.spr,[iw,ih]=dim(im),w=it.w,h=w*ih/iw,A=adj[it.id]||{s:1,x:0,y:0},ay={hijab:.1,neck:.62,pend:.55,glass:S.ey,hat:S.ty+.1}[it.type];
  ctx.save();if(it.type!=='ear'){ctx.translate(A.x,A.y+ay);ctx.scale(A.s,A.s);ctx.rotate((A.r||0)*Math.PI/180);ctx.translate(0,-ay)}
  if(it.type==='hijab'){const[hx,hy,hw]=it.hole,k=1.05/hw;ctx.drawImage(im,-hx*k,.1-hy*k,iw*k,ih*k)}
  else if(it.type==='neck')ctx.drawImage(im,-w/2,.62,w,h);
  else if(it.type==='pend'){const c=it.gold?['#d9a93e','#fff3c4']:['#aeb6c4','#ffffff'];
   ctx.beginPath();ctx.moveTo(-.42,.55);ctx.quadraticCurveTo(0,1.95,.42,.55);
   ctx.strokeStyle=c[0];ctx.lineWidth=.013;ctx.setLineDash([]);ctx.stroke();ctx.strokeStyle=c[1];ctx.lineWidth=.008;ctx.setLineDash([.012,.012]);ctx.stroke();ctx.setLineDash([]);
   ctx.drawImage(im,-w/2,1.22,w,h)}
  else if(it.type==='glass')ctx.drawImage(im,-w/2,S.ey-h/2,w,h);
  else if(it.type==='hat')ctx.drawImage(im,-w/2,S.ty+.1-it.ap*h,w,h);
  else [-1,1].forEach(sg=>{if(sg*S.nx>.2)return;ctx.save();ctx.translate(sg*(.5+A.x),.16+A.y);ctx.scale(A.s*(1-Math.min(.5,Math.abs(S.nx))),A.s);ctx.drawImage(im,-w/2,0,w,h);ctx.restore()});ctx.restore()});
 ctx.restore()}

/* ---------- shop UI ---------- */
const sel={},bag=[],adj={};let filter='All';
const fmt=n=>'Rs '+n.toLocaleString('en-US');
const toast=t=>{const e=$('toast');e.textContent=t;e.classList.add('s');setTimeout(()=>e.classList.remove('s'),1800)};
